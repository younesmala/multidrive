msgstr "exchanges with the MultiDrive team and response tracking"

#: .\vehicles\templates\vehicles\fonctionnement.html:124
msgid ""
"modification des informations personnelles, changement de mot de passe, "
"suppression du compte"
msgstr "editing personal information, changing password, deleting account"

#: .\vehicles\templates\vehicles\fonctionnement.html:126
msgid ""
